# Copy to .env for local use. .env is git-ignored — never commit real keys.
# Nothing here is required; every tool degrades gracefully without a key.

# https://www.virustotal.com/gui/join-us  (free tier: 4 requests/min)
VIRUSTOTAL_API_KEY=

# https://nvd.nist.gov/developers/request-an-api-key
# Without a key NVD allows 5 requests per 30 seconds and returns HTTP 403 above that.
NVD_API_KEY=

# --- Network policy ---------------------------------------------------------
# Permits private/loopback targets. ONLY set this on an isolated lab machine
# with no credentials reachable on the local network. Cloud metadata addresses
# stay blocked either way.
# CYBERSEC_MCP_ALLOW_PRIVATE_TARGETS=0
# CYBERSEC_MCP_ALLOWED_PORTS=80,443,8080,8443
# CYBERSEC_MCP_TIMEOUT=12
# CYBERSEC_MCP_MAX_REDIRECTS=3

# --- Audit ------------------------------------------------------------------
# CYBERSEC_MCP_AUDIT=1
# CYBERSEC_MCP_AUDIT_PATH=~/.cybersec-mcp/audit.jsonl
